name: Deploy to GitHub Pages

# Собирается и публикуется автоматически при каждом push в main —
# всё происходит на серверах GitHub, локальный компьютер не участвует.
on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - run: npm install
      - run: npm run build
        env:
          # URL бэкенда — задаётся один раз в Settings → Secrets and variables →
          # Actions → New repository secret → VITE_API_URL. Секреты хранятся у GitHub,
          # не на чьём-либо компьютере.
          VITE_API_URL: ${{ secrets.VITE_API_URL }}

      - uses: actions/upload-pages-artifact@v3
        with:
          path: dist

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
