# Этот файл — только для справки, что нужно бэкенду.
# В самом проекте .env не используется и не коммитится — вместо этого
# значение задаётся один раз как секрет в GitHub (Settings → Secrets and
# variables → Actions → New repository secret → VITE_API_URL), и подставляется
# автоматически при сборке через GitHub Actions. См. README.md.
VITE_API_URL=https://script.google.com/macros/s/ВАШ_DEPLOYMENT_ID/exec

# 2 — blockId рекламного блока Rewarded-формата из личного кабинета
# https://partner.adsgram.ai. Задаётся так же, как VITE_API_URL — секретом в
# GitHub Actions. Если не задан, кнопка "+1 за рекламу" в тренажёре отключена
# (без SDK/blockId показывать нечего — заглушки больше нет).
VITE_ADSGRAM_BLOCK_ID=123456
